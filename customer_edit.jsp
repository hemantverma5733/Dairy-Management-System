<%@ page import="com.smartdairy.entity.Customer" %><%@ page import="com.smartdairy.service.CustomerService" %>
<% Customer c=null; try{ c=new CustomerService().findById(Integer.parseInt(request.getParameter("id"))); }catch(Exception e){ throw new jakarta.servlet.ServletException(e); } %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Edit Customer - Smart Dairy</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><div class="container py-5"><div class="card shadow-sm mx-auto" style="max-width:850px"><div class="card-body"><h3>Edit Customer</h3><% if(c==null){%><div class="alert alert-danger">Customer not found.</div><a class="btn btn-secondary" href="customer.jsp">Back</a><%}else{%><form action="CustomerUpdateServlet" method="post" class="row g-3"><input type="hidden" name="id" value="<%=c.getId()%>"><div class="col-md-6"><label class="form-label">Name</label><input class="form-control" name="name" value="<%=c.getName()%>" required></div><div class="col-md-6"><label class="form-label">Mobile</label><input class="form-control" name="mobile" value="<%=c.getMobile()%>" pattern="[0-9]{10}" maxlength="10" required></div><div class="col-md-6"><label class="form-label">Address</label><input class="form-control" name="address" value="<%=c.getAddress()==null?"":c.getAddress()%>"></div><div class="col-md-3"><label class="form-label">Type</label><select class="form-select" name="customer_type"><% String[] types={"RETAIL","WHOLESALER","HOTEL","RESTAURANT","OTHER"}; for(String t:types){%><option <%=t.equals(c.getCustomerType())?"selected":""%>><%=t%></option><%}%></select></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="status"><option <%= "ACTIVE".equals(c.getStatus())?"selected":""%>>ACTIVE</option><option <%= "INACTIVE".equals(c.getStatus())?"selected":""%>>INACTIVE</option></select></div><div class="col-12"><button class="btn btn-success">Update Customer</button> <a href="customer.jsp" class="btn btn-secondary">Cancel</a></div></form><%}%></div></div></div></body></html>
