<%@ page import="java.util.*,com.smartdairy.entity.Supplier,com.smartdairy.service.SupplierService" %>
<% String q=request.getParameter("q"); List<Supplier> suppliers=new SupplierService().search(q); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Suppliers - Smart Dairy</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><nav class="navbar navbar-dark bg-success"><div class="container"><span class="navbar-brand">Smart Dairy — Suppliers</span></div></nav><main class="container py-4"><% if(request.getParameter("success")!=null||request.getParameter("updated")!=null||request.getParameter("deleted")!=null){ %><div class="alert alert-success">Supplier operation completed successfully.</div><% } %><% if(request.getParameter("error")!=null){ %><div class="alert alert-danger"><%=request.getParameter("error")%></div><% } %><div class="card shadow-sm mb-4"><div class="card-body"><h4>Add Supplier / Farmer</h4><form action="SupplierServlet" method="post" class="row g-3"><div class="col-md-6"><label class="form-label">Name</label><input name="name" class="form-control" required></div><div class="col-md-6"><label class="form-label">Mobile</label><input name="mobile" pattern="[0-9]{10}" maxlength="10" class="form-control" required></div><div class="col-md-6"><label class="form-label">Address</label><input name="address" class="form-control"></div><div class="col-md-3"><label class="form-label">Animal</label><select name="animal_type" class="form-select"><option>Cow</option><option>Buffalo</option><option>Both</option></select></div><div class="col-md-3"><label class="form-label">Status</label><select name="status" class="form-select"><option>ACTIVE</option><option>INACTIVE</option></select></div><div class="col-md-8"><label class="form-label">Bank / UPI Details</label><input name="bank_details" class="form-control"></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-success w-100">Add Supplier</button></div></form></div></div><div class="card shadow-sm"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-3"><h4 class="mb-0">Supplier List</h4><form class="d-flex gap-2"><input name="q" value="<%=q==null?"":q%>" class="form-control" placeholder="Search name, mobile, animal"><button class="btn btn-outline-success">Search</button></form></div><div class="table-responsive"><table class="table table-hover"><thead class="table-success"><tr><th>ID</th><th>Name</th><th>Mobile</th><th>Animal</th><th>Status</th><th>Action</th></tr></thead><tbody><% for(Supplier s:suppliers){ %><tr><td><%=s.getId()%></td><td><%=s.getName()%></td><td><%=s.getMobile()%></td><td><%=s.getAnimalType()%></td><td><span class="badge <%= "ACTIVE".equals(s.getStatus())?"text-bg-success":"text-bg-secondary"%>"><%=s.getStatus()%></span></td><td><a class="btn btn-sm btn-outline-danger" href="SupplierDeleteServlet?id=<%=s.getId()%>" onclick="return confirm('Delete this supplier?')">Delete</a></td></tr><% } %></tbody></table></div></div></div></main></body></html>
