<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Milk Collection - Smart Dairy</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><nav class="navbar navbar-dark bg-success"><div class="container"><span class="navbar-brand">Smart Dairy — Milk Collection</span></div></nav><main class="container py-4"><% if(request.getParameter("success")!=null){ %><div class="alert alert-success">Milk collection saved. Amount was calculated automatically as Quantity × Rate.</div><% } %><% if(request.getParameter("error")!=null){ %><div class="alert alert-danger"><%=request.getParameter("error")%></div><% } %><div class="card shadow-sm mx-auto" style="max-width:850px"><div class="card-body p-4"><h3 class="mb-4">Daily Milk Collection</h3><form action="MilkCollectionServlet" method="post" class="row g-3"><div class="col-md-6"><label class="form-label">Collection Date</label><input type="date" name="collection_date" class="form-control" required></div><div class="col-md-6"><label class="form-label">Supplier / Farmer</label><input name="supplier_name" class="form-control" required></div><div class="col-md-6"><label class="form-label">Shift</label><select name="shift" class="form-select" required><option value="">Select</option><option>MORNING</option><option>EVENING</option></select></div><div class="col-md-6"><label class="form-label">Animal Type</label><select name="animal_type" class="form-select" required><option value="">Select</option><option>COW</option><option>BUFFALO</option></select></div><div class="col-md-6"><label class="form-label">Quantity (Litres)</label><input type="number" name="quantity" step="0.01" min="0.01" class="form-control" required></div><div class="col-md-6"><label class="form-label">Rate (₹ / Litre)</label><input type="number" name="rate" step="0.01" min="0" class="form-control" required></div><div class="col-md-6"><label class="form-label">Fat (%)</label><input type="number" name="fat" step="0.01" min="0" class="form-control"></div><div class="col-md-6"><label class="form-label">SNF (%)</label><input type="number" name="snf" step="0.01" min="0" class="form-control"></div><div class="col-12"><div class="alert alert-info mb-0">Payment amount = <strong>Quantity × Rate</strong>. Example: 20 L × ₹45 = ₹900.</div></div><div class="col-12"><button class="btn btn-success w-100">Save Milk Collection</button></div></form></div></div></main></body></html>
